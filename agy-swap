class Spinner:
    def __init__(self, message="Loading...", delay=0.08):
        self.message = message
        self.delay = delay
        self.spinner_chars = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
        self.running = False
        self.thread = None

    def spin(self):
        idx = 0
        while self.running:
            sys.stdout.write(f"\r{ORANGE}{self.spinner_chars[idx % len(self.spinner_chars)]}{RESET} {self.message}")
            sys.stdout.flush()
            idx += 1
            time.sleep(self.delay)

    def __enter__(self):
        self.running = True
        self.thread = threading.Thread(target=self.spin, daemon=True)
        self.thread.start()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        self.running = False
        if self.thread:
            self.thread.join()
        sys.stdout.write("\r\033[K")
        sys.stdout.flush()

def enable_windows_ansi():
    if platform.system() == "Windows":
        try:
            import ctypes
            kernel32 = ctypes.windll.kernel32
            handle = kernel32.GetStdHandle(-11)
            mode = ctypes.c_ulong()
            kernel32.GetConsoleMode(handle, ctypes.byref(mode))
            kernel32.SetConsoleMode(handle, mode.value | 0x0004)
        except Exception:
            pass

def get_windows_credential():
    try:
        import ctypes
        from ctypes import wintypes
        Advapi32 = ctypes.windll.advapi32
        target_name = "gemini:antigravity"
        
        class CREDENTIAL(ctypes.Structure):
            _fields_ = [
                ('Flags', wintypes.DWORD),
                ('Type', wintypes.DWORD),
                ('TargetName', wintypes.LPWSTR),
                ('Comment', wintypes.LPWSTR),
                ('LastWritten', ctypes.c_void_p),
                ('CredentialBlobSize', wintypes.DWORD),
                ('CredentialBlob', ctypes.c_char_p),
                ('Persist', wintypes.DWORD),
                ('AttributeCount', wintypes.DWORD),
                ('Attributes', ctypes.c_void_p),
                ('TargetAlias', wintypes.LPWSTR),
                ('UserName', wintypes.LPWSTR)
            ]
        
        pcred = ctypes.POINTER(CREDENTIAL)()
        res = Advapi32.CredReadW(
            ctypes.c_wchar_p(target_name),
            wintypes.DWORD(1),
            wintypes.DWORD(0),
            ctypes.byref(pcred)
        )
        if res:
            blob = pcred.contents.CredentialBlob[:pcred.contents.CredentialBlobSize]
            Advapi32.CredFree(pcred)
            return blob.decode('utf-8').strip()
    except Exception:
        pass
    return None

def set_windows_credential(value):
    try:
        import ctypes
        from ctypes import wintypes
        Advapi32 = ctypes.windll.advapi32
        target_name = "gemini:antigravity"
        
        class CREDENTIAL(ctypes.Structure):
            _fields_ = [
                ('Flags', wintypes.DWORD),
                ('Type', wintypes.DWORD),
                ('TargetName', wintypes.LPWSTR),
                ('Comment', wintypes.LPWSTR),
                ('LastWritten', ctypes.c_void_p),
                ('CredentialBlobSize', wintypes.DWORD),
                ('CredentialBlob', ctypes.c_char_p),
                ('Persist', wintypes.DWORD),
                ('AttributeCount', wintypes.DWORD),
                ('Attributes', ctypes.c_void_p),
                ('TargetAlias', wintypes.LPWSTR),
                ('UserName', wintypes.LPWSTR)
            ]
            
        blob = value.encode('utf-8')
        cred = CREDENTIAL(
            Flags=0,
            Type=1,
            TargetName=target_name,
            Comment=None,
            LastWritten=None,
            CredentialBlobSize=len(blob),
            CredentialBlob=blob,
            Persist=3,
            AttributeCount=0,
            Attributes=None,
            TargetAlias=None,
            UserName="antigravity"
        )
        res = Advapi32.CredWriteW(ctypes.byref(cred), wintypes.DWORD(0))
        return bool(res)
    except Exception:
        return False

