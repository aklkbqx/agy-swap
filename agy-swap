def parse_duration_seconds(duration_str):
    if not duration_str:
        return None
    duration_str = duration_str.strip().lower()
    if duration_str in ("reset", "clear", "0", "none"):
        return 0
    hours, mins, secs = 0, 0, 0
    
    h_match = re.search(r"(\d+)\s*h", duration_str)
    m_match = re.search(r"(\d+)\s*m", duration_str)
    s_match = re.search(r"(\d+)\s*s", duration_str)
    
    if h_match:
        hours = int(h_match.group(1))
    if m_match:
        mins = int(m_match.group(1))
    if s_match:
        secs = int(s_match.group(1))
        
    if not h_match and not m_match and not s_match:
        if duration_str.isdigit():
            mins = int(duration_str)
        else:
            return None
            
    return hours * 3600 + mins * 60 + secs

def cmd_set_limit(args):
    accounts = load_accounts()
    if not accounts:
        print("No accounts found.")
        return

    target = getattr(args, "account", None)
    duration_str = getattr(args, "duration", None)
    
    if not target:
        target = input("Enter account email or index: ").strip()
    
    selected_email = None
    if target and target.isdigit():
        idx = int(target) - 1
        keys = list(accounts.keys())
        if 0 <= idx < len(keys):
            selected_email = keys[idx]
    elif target:
        for email in accounts.keys():
            if target.lower() in email.lower():
                selected_email = email
                break

    if not selected_email:
        print(f"{RED}Account '{target}' not found.{RESET}")
        return

    if not duration_str:
        print(f"\n{BOLD}Preset Options:{RESET}")
        print("  [1] 5 Hours (Standard 5-Hour Rolling Limit)")
        print("  [2] Custom (e.g. '4h41m', '30m')")
        print("  [3] Clear / Reset")
        choice = input("\nSelect option or enter duration (default 5h): ").strip()
        if choice == "1" or not choice:
            duration_str = "5h"
        elif choice == "3":
            duration_str = "reset"
        elif choice == "2":
            duration_str = input("Enter duration (e.g. '4h41m'): ").strip()
        else:
            duration_str = choice

    seconds = parse_duration_seconds(duration_str)
    if seconds is None:
        print(f"{RED}Invalid duration format. Use e.g. '5h', '4h41m', '30m', 'reset'.{RESET}")
        return

    if seconds == 0:
        accounts[selected_email].pop("limit_reset", None)
        save_accounts(accounts)
        print(f"{GREEN}✔ Cleared rate limit cooldown timer for '{selected_email}'.{RESET}")
        return

    reset_time = datetime.now(timezone.utc) + timedelta(seconds=seconds)
    accounts[selected_email]["limit_reset"] = reset_time.isoformat()
    save_accounts(accounts)
    
    h = seconds // 3600
    m = (seconds % 3600) // 60
    dur_fmt = f"{h}h {m}m" if h else f"{m}m"
    print(f"{GREEN}✔ Set rate limit cooldown for '{selected_email}' to {reset_time.strftime('%H:%M:%S UTC')} (in {dur_fmt}).{RESET}")


