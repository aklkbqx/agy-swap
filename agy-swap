def sort_accounts(acc_list, mode="active", active_email=None):
    if not acc_list or not mode or mode == "default":
        return list(acc_list)
        
    if mode in ("active", "active_first"):
        return sorted(acc_list, key=lambda a: 0 if (active_email and a.get("email", "").lower() == active_email.lower()) else 1)
        
    elif mode in ("name", "name_az"):
        return sorted(acc_list, key=lambda a: a.get("name", "").lower())
        
    elif mode in ("email", "email_az"):
        return sorted(acc_list, key=lambda a: a.get("email", "").lower())
        
    elif mode in ("limit", "expiry", "reset"):
        def limit_key(acc):
            limit_reset = acc.get("limit_reset")
            if limit_reset:
                try:
                    dt = datetime.fromisoformat(limit_reset)
                    diff = (dt - datetime.now(timezone.utc)).total_seconds()
                    if diff > 0:
                        return diff
                except Exception:
                    pass
            info = get_token_reset_info(acc.get("token_data", ""))
            if info and info.get("status") == "active":
                return info.get("seconds", 0)
            elif info and info.get("status") == "ready":
                return 0
            return 9999999
        return sorted(acc_list, key=limit_key)
        
    return list(acc_list)

