def get_google_userinfo(access_token):
    url = "https://www.googleapis.com/oauth2/v1/userinfo"
    try:
        req = urllib.request.Request(url, headers={"Authorization": f"Bearer {access_token}"})
        with urllib.request.urlopen(req, timeout=5) as response:
            if response.status == 200:
                data = json.loads(response.read().decode("utf-8"))
                return data
    except Exception:
        pass
    return None

def find_antigravity_logs():
    log_dirs = [
        os.path.expanduser("~/Library/Logs/Google Antigravity"),
        os.path.expanduser("~/Library/Logs/Antigravity"),
        os.path.expanduser("~/.config/antigravity/logs"),
        os.path.expanduser("~/.gemini/antigravity-cli/logs"),
    ]
    if platform.system() == "Windows":
        appdata = os.getenv("LOCALAPPDATA")
        if appdata:
            log_dirs.append(os.path.join(appdata, "Google", "Antigravity", "logs"))
            log_dirs.append(os.path.join(appdata, "Antigravity", "logs"))

    found_files = []
    for d in log_dirs:
        if os.path.exists(d):
            found_files.extend(glob.glob(os.path.join(d, "*.log")))
            found_files.extend(glob.glob(os.path.join(d, "**", "*.log"), recursive=True))

    found_files.sort(key=lambda x: os.path.getmtime(x), reverse=True)
    return found_files

def auto_scan_logs_for_limits():
    log_files = find_antigravity_logs()
    if not log_files:
        return {}
        
    email_regex = re.compile(r"applyAuthResult:\s*email=([^\s,]+)")
    error_regex = re.compile(r"RESOURCE_EXHAUSTED.*?Resets\s+in\s+((?:\d+h)?(?:\d+m)?(?:\d+s)?)")
    ts_regex = re.compile(r"^[IWEF](\d{2})(\d{2})\s+(\d{2}):(\d{2}):(\d{2})")
    
    detected_limits = {}
    now = datetime.now(timezone.utc)
    current_year = now.year

    for log_file in log_files[:15]:
        current_email = None
        try:
            with open(log_file, "r", errors="ignore") as f:
                for line in f:
                    em_match = email_regex.search(line)
                    if em_match:
                        current_email = em_match.group(1).lower()
                    
                    err_match = error_regex.search(line)
                    if err_match and current_email:
                        dur_str = err_match.group(1).strip()
                        h_m = re.search(r"(\d+)h", dur_str)
                        m_m = re.search(r"(\d+)m", dur_str)
                        s_m = re.search(r"(\d+)s", dur_str)
                        h = int(h_m.group(1)) if h_m else 0
                        m = int(m_m.group(1)) if m_m else 0
                        s = int(s_m.group(1)) if s_m else 0
                        total_secs = h*3600 + m*60 + s
                        
                        ts_match = ts_regex.match(line)
                        if ts_match:
                            mon = int(ts_match.group(1))
                            day = int(ts_match.group(2))
                            hr = int(ts_match.group(3))
                            mi = int(ts_match.group(4))
                            se = int(ts_match.group(5))
                            local_dt = datetime(current_year, mon, day, hr, mi, se).astimezone()
                            log_dt = local_dt.astimezone(timezone.utc)
                        else:
                            file_mtime = os.path.getmtime(log_file)
                            log_dt = datetime.fromtimestamp(file_mtime, tz=timezone.utc)
                            
                        reset_dt = log_dt + timedelta(seconds=total_secs)
                        
                        if reset_dt > now:
                            if current_email not in detected_limits or reset_dt > detected_limits[current_email]:
                                detected_limits[current_email] = reset_dt
        except Exception:
            pass
            
    return detected_limits

def load_accounts(sync_logs=True):
    if not os.path.exists(ACCOUNTS_FILE):
        accounts = {}
    else:
        try:
            with open(ACCOUNTS_FILE, "r") as f:
                accounts = json.load(f)
        except Exception:
            accounts = {}

    if sync_logs and accounts:
        changed = False
        now = datetime.now(timezone.utc)
        
        for email, acc in list(accounts.items()):
            limit_reset = acc.get("limit_reset")
            if limit_reset:
                try:
                    dt = datetime.fromisoformat(limit_reset)
                    if dt <= now:
                        acc.pop("limit_reset", None)
                        changed = True
                except Exception:
                    pass
                    
        detected_limits = auto_scan_logs_for_limits()
        for email, reset_dt in detected_limits.items():
            for acc_email, acc in accounts.items():
                if acc_email.lower() == email:
                    existing = acc.get("limit_reset")
                    new_iso = reset_dt.isoformat()
                    if existing != new_iso:
                        acc["limit_reset"] = new_iso
                        changed = True

        if changed:
            save_accounts(accounts)

    return accounts

def save_accounts(accounts):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(ACCOUNTS_FILE, "w") as f:
        json.dump(accounts, f, indent=2)

def decode_token(keychain_val):
    if not keychain_val or not keychain_val.startswith("go-keyring-base64:"):
        return None
    try:
        encoded = keychain_val.split(":", 1)[1]
        return json.loads(base64.b64decode(encoded).decode("utf-8"))
    except Exception:
        return None

def get_token_reset_info(token_data_str):
    token_json = decode_token(token_data_str)
    if not token_json or "token" not in token_json:
        return None
    token_obj = token_json["token"]
    expiry_str = token_obj.get("expiry")
    has_refresh = bool(token_obj.get("refresh_token"))
    
    if not expiry_str:
        return None
    try:
        dt = datetime.fromisoformat(expiry_str)
        now = datetime.now(timezone.utc)
        diff = (dt - now).total_seconds()
        if diff > 0:
            mins = int(diff // 60)
            secs = int(diff % 60)
            if mins >= 60:
                hours = mins // 60
                rem_mins = mins % 60
                return {"status": "active", "remaining_str": f"{hours}h {rem_mins}m", "seconds": diff, "expiry_dt": dt}
            return {"status": "active", "remaining_str": f"{mins}m {secs}s", "seconds": diff, "expiry_dt": dt}
        else:
            if has_refresh:
                return {"status": "ready", "remaining_str": "Auto-refreshes", "seconds": diff, "expiry_dt": dt}
            else:
                abs_mins = int(abs(diff) // 60)
                return {"status": "expired", "remaining_str": f"Expired {abs_mins}m ago", "seconds": diff, "expiry_dt": dt}
    except Exception:
        return None

def get_account_limit_display(acc, is_active=False, current_token_str=None):
    limit_reset = acc.get("limit_reset")
    if limit_reset:
        try:
            dt = datetime.fromisoformat(limit_reset)
            now = datetime.now(timezone.utc)
            diff = (dt - now).total_seconds()
            if diff > 0:
                mins = int(diff // 60)
                if mins >= 60:
                    h = mins // 60
                    m = mins % 60
                    return f"{YELLOW}Cooldown ({h}h {m}m){RESET}"
                return f"{YELLOW}Cooldown ({mins}m){RESET}"
        except Exception:
            pass

    return f"{GREEN}Ready{RESET}" if is_active else f"{GRAY}Ready{RESET}"

def get_avatar_badge(name, email):
    name_str = name.strip() if name else ""
    parts = name_str.split()
    if len(parts) >= 2 and parts[0] and parts[1]:
        initials = (parts[0][0] + parts[1][0]).upper()
    elif len(parts) == 1 and parts[0]:
        initials = parts[0][:2].upper()
    else:
        initials = email[:2].upper() if email else "GU"

    bg_colors = [166, 172, 64, 71, 133, 167, 31, 68]
    bg_code = bg_colors[abs(hash(email)) % len(bg_colors)]
    return f"\033[48;5;{bg_code}m\033[38;5;255m\033[1m {initials} \033[0m"

def render_progress_bar(percent, width=16):
    percent = max(0, min(100, percent))
    filled_len = int(width * percent / 100)
    empty_len = width - filled_len
    
    if percent > 50:
        bar_color = GREEN
    elif percent > 20:
        bar_color = YELLOW
    else:
        bar_color = RED
        
    bar = f"{bar_color}{'█' * filled_len}{DARK_GRAY}{'░' * empty_len}{RESET}"
    return f"[{bar}] {percent}%"

def visible_len(text):
    ANSI_ESCAPE = re.compile(r"\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])")
    return len(ANSI_ESCAPE.sub("", text))

def get_responsive_width():
    try:
        cols, _ = shutil.get_terminal_size((80, 24))
        return max(50, min(cols - 2, 110))
    except Exception:
        return 76

def get_key():
    if platform.system() == "Windows":
        import msvcrt
        ch = msvcrt.getch()
        if ch in (b"\x00", b"\xe0"):
            ch2 = msvcrt.getch()
            if ch2 == b"H":
                return "up"
            elif ch2 == b"P":
                return "down"
        elif ch in (b"\r", b"\n"):
            return "\n"
        try:
            return ch.decode("utf-8")
        except Exception:
            return ""
    else:
        import sys, tty, termios
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setraw(sys.stdin.fileno())
            ch = sys.stdin.read(1)
            if ch == "\x1b":
                ch2 = sys.stdin.read(1)
                if ch2 == "[":
                    ch3 = sys.stdin.read(1)
                    if ch3 == "A":
                        return "up"
                    elif ch3 == "B":
                        return "down"
                return "esc"
            elif ch in ("\r", "\n"):
                return "\n"
            elif ch == "\x7f":
                return "backspace"
            return ch
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

def cmd_add_flow():
    current_token = get_current_keychain_token()
    backup_token = current_token
    
    print(f"\n{BOLD}Add / Login Google Account{RESET}")
    print(f"{GRAY}1. Open browser to authenticate with Google.{RESET}")
    print(f"{GRAY}2. Complete login in Google Antigravity.{RESET}")
    input(f"{CYAN}Press Enter when ready to start login...{RESET}")
    
    delete_keychain_token()
    
    print(f"\n{YELLOW}Waiting for login token in Keychain...{RESET}")
    print(f"{GRAY}(Run 'agy' in another terminal window if prompt does not open automatically){RESET}\n")
    
    new_token = None
    with Spinner("Polling Keychain for new token..."):
        start_time = time.time()
        while time.time() - start_time < 120:
            t = get_current_keychain_token()
            if t and t != backup_token:
                new_token = t
                break
            time.sleep(1.5)
            
    if not new_token:
        print(f"\n{RED}Timed out waiting for login.{RESET}")
        if backup_token:
            set_keychain_token(backup_token)
        return False, "Login timed out"
        
    token_json = decode_token(new_token)
    if not token_json or "token" not in token_json or "access_token" not in token_json["token"]:
        print(f"\n{RED}Invalid token structure received.{RESET}")
        if backup_token:
            set_keychain_token(backup_token)
        return False, "Invalid token structure"
        
    access_token = token_json["token"]["access_token"]
    new_userinfo = None
    with Spinner("Fetching Google profile & avatar..."):
        new_userinfo = get_google_userinfo(access_token)
        
    accounts = load_accounts(sync_logs=False)
    if new_userinfo and new_userinfo.get("email"):
        email = new_userinfo.get("email")
        name = new_userinfo.get("name", "Google User")
        picture = new_userinfo.get("picture", "")
        accounts[email] = {
            "email": email,
            "name": name,
            "picture": picture,
            "token_data": new_token
        }
        save_accounts(accounts)
        print(f"\n{GREEN}✓ Successfully saved account: {name} <{email}>{RESET}")
        return True, f"Added {email}"
    else:
        email = input("Enter account email manually: ").strip()
        if email:
            accounts[email] = {
                "email": email,
                "name": "Google User",
                "picture": "",
                "token_data": new_token
            }
            save_accounts(accounts)
            print(f"\n{GREEN}✓ Saved account: {email}{RESET}")
            return True, f"Added {email}"
        else:
            if backup_token:
                set_keychain_token(backup_token)
            return False, "No email provided"

def cmd_add(args):
    token_arg = getattr(args, "token", None)
    if token_arg is not None:
        token_str = sys.stdin.read().strip() if token_arg == "-" else token_arg.strip()
        if not token_str:
            print(f"{RED}Empty token provided.{RESET}")
            sys.exit(1)
        token_json = decode_token(token_str)
        if not token_json or "token" not in token_json or "access_token" not in token_json["token"]:
            print(f"{RED}Could not parse token.{RESET}")
            sys.exit(1)
            
        access_token = token_json["token"]["access_token"]
        userinfo = None
        with Spinner("Fetching Google profile & avatar..."):
            userinfo = get_google_userinfo(access_token)
        
        if not userinfo:
            email = input("Enter email address manually: ").strip()
            name = "Google User"
            picture = ""
        else:
            email = userinfo.get("email")
            name = userinfo.get("name", "Google User")
            picture = userinfo.get("picture", "")

        if not email:
            print(f"{RED}Email address is required.{RESET}")
            sys.exit(1)

        accounts = load_accounts(sync_logs=False)
        accounts[email] = {
            "email": email,
            "name": name,
            "picture": picture,
            "token_data": token_str
        }
        save_accounts(accounts)
        print(f"{GREEN}✓ Saved account '{email}'.{RESET}")
    else:
        cmd_add_flow()

def get_active_account_email(accounts, current_token=None):
    if current_token is None:
        current_token = get_current_keychain_token()
    if not current_token:
        return None
    for email, acc in accounts.items():
        if acc.get("token_data") == current_token:
            return email
    token_json = decode_token(current_token)
    if token_json and "token" in token_json and "access_token" in token_json["token"]:
        userinfo = get_google_userinfo(token_json["token"]["access_token"])
        if userinfo:
            return userinfo.get("email")
    return None

def resolve_account_target(target, accounts):
    if not target or not accounts:
        return None
    target_str = str(target).strip()
    keys = list(accounts.keys())
    if target_str.isdigit():
        idx = int(target_str) - 1
        if 0 <= idx < len(keys):
            return keys[idx]
    else:
        for email in keys:
            if target_str.lower() in email.lower():
                return email
    return None

