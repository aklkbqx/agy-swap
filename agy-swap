def cmd_update(args):
    url = "https://raw.githubusercontent.com/aklkbqx/agy-swap/main/agy-swap"
    target = os.path.abspath(sys.argv[0])
    if not os.path.exists(target) or not os.access(target, os.W_OK):
        target = os.path.expanduser("~/.local/bin/agy-swap")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=10) as response:
            content = response.read()
        if not content:
            print(f"{RED}Error: Empty update content received.{RESET}")
            return False
        temp_target = target + ".tmp"
        with open(temp_target, "wb") as f:
            f.write(content)
        os.chmod(temp_target, 0o755)
        os.replace(temp_target, target)
        print(f"{GREEN}✔ agy-swap updated successfully!{RESET}")
        return True
    except Exception as e:
        print(f"{RED}Failed to update: {e}{RESET}")
        return False

