                        message = f"Failed to switch to {acc['email']}"
                        message_type = "error"
                elif itype == 'action':
                    if val == 'sort':
                        current_sort_idx = (current_sort_idx + 1) % len(SORT_MODES)
                        message = f"Sort order: {SORT_MODES[current_sort_idx][1]}"
                        message_type = "info"
                        continue

                    sys.stdout.write("\033[?1049l\033[?25h")
                    sys.stdout.flush()

                    if val == 'add':
                        print(f"{BOLD}{ORANGE}--- Add / Login Account ---{RESET}")
                        success, msg = cmd_add_flow()
                        input("\nPress Enter to return...")
                        message = msg
                        message_type = "success" if success else "error"


                    elif val == 'remove':
                        message = "Highlight any account and press 'd', 'x' or Backspace to delete it."
                        message_type = "info"
                    elif val == 'limits':
                        print(f"{BOLD}{CYAN}--- Account Limit Resets & Quota Overview ---{RESET}")
                        cmd_limits(None)
                        input("\nPress Enter to return...")
                    elif val == 'set_limit':
                        print(f"{BOLD}{ORANGE}--- Set Account Limit Cooldown ---{RESET}")
                        cmd_set_limit(argparse.Namespace(account=None, duration=None))
                        input("\nPress Enter to return...")
                    elif val == 'status':
                        print(f"{BOLD}{BLUE}--- Session Status Details ---{RESET}")
                        cmd_status(None)
                        input("\nPress Enter to return...")
                    elif val == 'update':
                        print(f"{BOLD}{ORANGE}--- Update Switcher Script ---{RESET}")
                        with Spinner("Downloading latest version..."):
                            success = cmd_update(None)
                            time.sleep(0.5)
                        if success:
                            print(f"{GREEN}✔ Updated successfully! Please restart agy-swap.{RESET}")
                            time.sleep(1.5)
                            break
                        else:
                            input("\nPress Enter to return...")
                    elif val == 'logout':
                        print(f"{BOLD}{YELLOW}--- Logout Active Session ---{RESET}")
                        confirm = input("Confirm delete active password from Keychain? [y/N]: ").strip().lower()
                        if confirm == 'y':
                            with Spinner("Logging out..."):
                                delete_keychain_token()
                                time.sleep(0.5)
                            print(f"{GREEN}Logged out successfully.{RESET}")
                            time.sleep(1.0)
                            message = "Active session logged out"
                            message_type = "info"
                    elif val == 'quit':
                        break
                
                sys.stdout.write("\033[?1049h\033[?25l\033[H")
                sys.stdout.flush()
                continue
            
    finally:
        sys.stdout.write("\033[?1049l\033[?25h")
        sys.stdout.flush()


def main():
    enable_windows_ansi()
    parser = argparse.ArgumentParser(description="Multi-Account Switcher for Google Antigravity CLI (agy)")
    parser.add_argument("--add", action="store_true", help="Log in & add a Google account to managed accounts")
    parser.add_argument("--token", metavar="BLOB|-", help="Import a go-keyring token blob instead of reading the active session ('-' = stdin). Use with --add.")
    parser.add_argument("--list", action="store_true", help="List all saved accounts")
    parser.add_argument("--sort", choices=["active", "limit", "name", "email", "default"], default="active", help="Sort order for accounts list (active, limit, name, email, default)")
    parser.add_argument("--limits", action="store_true", help="Display limit reset & token expiry status for all accounts")
    parser.add_argument("--set-limit", dest="set_limit_account", metavar="ACCOUNT", help="Set rate limit cooldown for an account")
    parser.add_argument("--duration", metavar="DURATION", help="Cooldown duration (e.g. '4h', '30m', 'reset') for --set-limit")
    parser.add_argument("--switch-to", dest="switch_to", metavar="ACCOUNT", help="Switch to specific account (email or number)")
    parser.add_argument("--switch", action="store_true", help="Rotate/interactive switch")
    parser.add_argument("--remove", dest="remove_account", metavar="ACCOUNT", help="Remove a saved account")
    parser.add_argument("--status", action="store_true", help="Show active account details")
    parser.add_argument("--logout", action="store_true", help="Logout of the active session")
    parser.add_argument("--update", action="store_true", help="Update the switcher script to the latest version")

    subparsers = parser.add_subparsers(dest="command", help="Subcommand to run")
    subparsers.add_parser("add", help="Log in & add a Google account")

    list_parser = subparsers.add_parser("list", help="List all saved accounts")
    list_parser.add_argument("--sort", choices=["active", "limit", "name", "email", "default"], default="active", help="Sort order")

    subparsers.add_parser("limits", help="Display limit reset & token expiry status for all accounts")
    subparsers.add_parser("logout", help="Logout of active session")
    subparsers.add_parser("update", help="Update the switcher script")
    
    switch_parser = subparsers.add_parser("switch", help="Switch to an account")
    switch_parser.add_argument("account", nargs="?", help="Account email or index")

    remove_parser = subparsers.add_parser("remove", help="Remove a saved account")
    remove_parser.add_argument("account", nargs="?", help="Account email or index")

    subparsers.add_parser("status", help="Show active account details")

    limit_parser = subparsers.add_parser("limit", help="Limit management commands")
    limit_subparsers = limit_parser.add_subparsers(dest="limit_action", help="Limit subcommand")
    set_parser = limit_subparsers.add_parser("set", help="Set rate limit cooldown for an account")
    set_parser.add_argument("account", nargs="?", help="Account email or index")
    set_parser.add_argument("duration", nargs="?", help="Duration e.g. 4h, 30m, reset")

    args = parser.parse_args()

    if args.add or args.command == "add" or args.token is not None:
        cmd_add(args)
    elif args.list or args.command == "list":
        cmd_list(args)
    elif args.limits or args.command == "limits":
        cmd_limits(args)
    elif args.set_limit_account:
        args.account = args.set_limit_account
        cmd_set_limit(args)
    elif args.command == "limit" and getattr(args, "limit_action", None) == "set":
        cmd_set_limit(args)
    elif args.logout or args.command == "logout":
        cmd_logout(args)
    elif args.update or args.command == "update":
        cmd_update(args)
    elif args.switch_to:
        args.account = args.switch_to
        cmd_switch(args)
    elif args.switch:
        args.account = None
        cmd_switch(args)
    elif args.remove_account:
        args.account = args.remove_account
        cmd_remove(args)
    elif args.command == "switch":
        cmd_switch(args)
    elif args.command == "remove":
        cmd_remove(args)
    elif args.command == "status" or args.status:
        cmd_status(args)
    else:
        cmd_interactive(args)


if __name__ == "__main__":
    main()
