def get_current_keychain_token():
    plat = platform.system()
    if plat == "Darwin":
        try:
            val = subprocess.check_output(
                ["security", "find-generic-password", "-a", "antigravity", "-s", "gemini", "-w"],
                stderr=subprocess.DEVNULL
            ).decode("utf-8").strip()
            return val
        except subprocess.CalledProcessError:
            return None
    elif plat == "Windows":
        return get_windows_credential()
    elif plat == "Linux":
        return get_linux_credential()
    return None

def set_keychain_token(token_data_str):
    plat = platform.system()
    if plat == "Darwin":
        try:
            subprocess.run(
                ["security", "delete-generic-password", "-a", "antigravity", "-s", "gemini"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            subprocess.run(
                ["security", "add-generic-password", "-a", "antigravity", "-s", "gemini", "-w", token_data_str],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            return True
        except subprocess.CalledProcessError as e:
            print(f"{RED}Error updating Keychain: {e}{RESET}", file=sys.stderr)
            return False
    elif plat == "Windows":
        return set_windows_credential(token_data_str)
    elif plat == "Linux":
        return set_linux_credential(token_data_str)
    return False

