        print(f" {marker} [{i}] {avatar} {BOLD}{name}{RESET} {GRAY}<{email}>{RESET}{active_str}")
        print(f"       ↳ Status: {limit_info}")
    print(f"{GRAY}{'─'*65}{RESET}\n")

def cmd_switch(args):
    accounts = load_accounts()
    if not accounts:
        print(f"{GRAY}No accounts found. Add one with 'agy-swap add' first.{RESET}")
        sys.exit(1)

    target = getattr(args, "account", None)
    if not target:
        if sys.stdin.isatty():
            cmd_interactive(args)
            return
        else:
            print(f"{RED}Interactive mode requires TTY.{RESET}")
            sys.exit(1)

    selected_email = resolve_account_target(target, accounts)

    if not selected_email:
        print(f"{RED}Account '{target}' not found.{RESET}")
        sys.exit(1)

    acc = accounts[selected_email]
    print(f"Switching to {BOLD}{acc['name']}{RESET} {GRAY}<{acc['email']}>{RESET}...")
    with Spinner("Updating Keychain credentials..."):
        success = set_keychain_token(acc["token_data"])
    if success:
        print(f"{GREEN}✓ Successfully switched to {acc['email']}.{RESET}")
    else:
        print(f"{RED}✕ Failed to switch account.{RESET}")

def cmd_remove(args):
    accounts = load_accounts()
    if not accounts:
        print(f"{GRAY}No accounts found.{RESET}")
        sys.exit(1)

    target = getattr(args, "account", None)
    if not target:
        if sys.stdin.isatty():
            cmd_interactive(args)
            return
        else:
            print(f"{RED}Interactive mode requires TTY.{RESET}")
            sys.exit(1)

    selected_email = resolve_account_target(target, accounts)

    if not selected_email:
        print(f"{RED}Account '{target}' not found.{RESET}")
        sys.exit(1)

    confirm = input(f"Are you sure you want to remove '{selected_email}'? [y/N]: ").strip().lower()
    if confirm == "y":
        del accounts[selected_email]
        save_accounts(accounts)
        print(f"{GREEN}✓ Removed account '{selected_email}'.{RESET}")

def cmd_status(args):
    current_token = get_current_keychain_token()
    if not current_token:
        print(f"{GRAY}Status: Not logged in{RESET}")
        return

    accounts = load_accounts()
    active_email = get_active_account_email(accounts, current_token)

    if active_email and active_email in accounts:
        acc = accounts[active_email]
        limit_info = get_account_limit_display(acc, is_active=True, current_token_str=current_token)
        avatar = get_avatar_badge(acc.get("name", ""), active_email)
        print(f"Active Account: {avatar} {GREEN}● {acc['name']}{RESET} {GRAY}<{acc['email']}>{RESET}")
        print(f"Status: {limit_info}")
    else:
        email = active_email or "Unknown Session"
        print(f"Active Account: {YELLOW}● {email}{RESET} {GRAY}(Unsaved in agy-swap){RESET}")

def cmd_logout(args):
    current_token = get_current_keychain_token()
    if not current_token:
        print(f"{GRAY}Already logged out.{RESET}")
        return
    delete_keychain_token()
    print(f"{GREEN}✓ Logged out of active session.{RESET}")

def cmd_interactive(args):
    if not sys.stdin.isatty():
        cmd_list(args)
        return

    sys.stdout.write("\033[?1049h\033[?25l\033[H")
    sys.stdout.flush()

    resolved_cache = {}

    def get_active_details(token_str, accs):
        if not token_str:
            return None, None, False
        for email, acc in accs.items():
            if acc.get("token_data") == token_str:
                return email, acc.get("name", "Google User"), True
        if token_str in resolved_cache:
            e, n = resolved_cache[token_str]
            return e, n, False
        token_json = decode_token(token_str)
        if token_json and "token" in token_json and "access_token" in token_json["token"]:
            userinfo = get_google_userinfo(token_json["token"]["access_token"])
            if userinfo:
                e = userinfo.get("email")
                n = userinfo.get("name", "Google User")
                resolved_cache[token_str] = (e, n)
                return e, n, False
        return None, None, False

    try:
        selected_idx = 0
        message = ""
        message_type = "info"

        while True:
            accounts = load_accounts()
            current_token = get_current_keychain_token()
            active_email, active_name, is_saved = get_active_details(current_token, accounts)
            acc_list = list(accounts.values())

            items = []
            for acc in acc_list:
                items.append(("account", f"{acc['name']} <{acc['email']}>", acc))

            items.append(("action", "[a] Add Account", "add"))
            items.append(("action", "[d] Remove Account", "remove"))
            items.append(("action", "[i] Session Status", "status"))
            items.append(("action", "[q] Quit", "quit"))

            if selected_idx >= len(items):
                selected_idx = max(0, len(items) - 1)
            if selected_idx < 0:
                selected_idx = 0

            w = get_responsive_width()
            sep_line = f"{GRAY}{'─' * min(w, 80)}{RESET}"
            buf = []

            buf.append(f"{BOLD}{ORANGE}AGY SWAP{RESET} {GRAY}· Google Antigravity Session Manager{RESET}")
            buf.append(sep_line)

            if active_email:
                tag = f"{GREEN}(Saved){RESET}" if is_saved else f"{YELLOW}(Unsaved, press 'a' to save){RESET}"
                avatar_active = get_avatar_badge(active_name, active_email)
                buf.append(f" {BOLD}Active:{RESET} {GREEN}●{RESET} {avatar_active} {BOLD}{active_name}{RESET} {GRAY}<{active_email}>{RESET} {tag}")
            else:
                buf.append(f" {BOLD}Active:{RESET} {GRAY}○ Not logged in{RESET}")

            buf.append("")
            
            highlighted_acc = acc_list[selected_idx] if selected_idx < len(acc_list) else (acc_list[0] if acc_list else None)

            buf.append(f" {BOLD}ACCOUNTS{RESET} {GRAY}({len(acc_list)} total){RESET}")

            if not acc_list:
                buf.append(f"   {GRAY}No saved accounts. Press [a] to add an account.{RESET}")
            else:
                for idx_acc, acc in enumerate(acc_list):
                    is_selected = (idx_acc == selected_idx)
                    is_active = bool(active_email and acc["email"].lower() == active_email.lower())

                    cursor = f"{ORANGE}❯{RESET}" if is_selected else " "
                    dot = f"{GREEN}●{RESET}" if is_active else f"{GRAY}○{RESET}"
                    avatar = get_avatar_badge(acc.get("name", "Google User"), acc["email"])

                    limit_display = get_account_limit_display(acc, is_active=is_active, current_token_str=current_token)
                    idx_num = f"[{idx_acc + 1}]"

                    if is_selected:
                        buf.append(f" {cursor} {idx_num} {avatar} {dot} {BOLD}{BRIGHT_WHITE}{acc['name']}{RESET} {GRAY}<{acc['email']}>{RESET}  {limit_display}")
                    else:
                        buf.append(f" {cursor} {idx_num} {avatar} {dot} {acc['name']} {GRAY}<{acc['email']}>{RESET}  {limit_display}")

            if highlighted_acc:
                buf.append("")
                h_name = highlighted_acc.get("name", "Google User")
                h_email = highlighted_acc.get("email", "")
                buf.append(f" {BOLD}QUOTA TRACKER{RESET} {GRAY}(Highlighted: {h_name}){RESET}")

                limit_reset = highlighted_acc.get("limit_reset")
                rem_secs = 0
                if limit_reset:
                    try:
                        dt = datetime.fromisoformat(limit_reset)
                        rem_secs = max(0, (dt - datetime.now(timezone.utc)).total_seconds())
                    except Exception:
                        rem_secs = 0

                if rem_secs > 0:
                    pct = max(0, min(100, int((rem_secs / (5 * 3600)) * 100)))
                    mins = int(rem_secs // 60)
                    dur = f"{mins // 60}h {mins % 60}m" if mins >= 60 else f"{mins}m"
                    bar = render_progress_bar(100 - pct, width=18)
                    buf.append(f"   5-Hour Quota  {bar}  {YELLOW}Cooldown ({dur}){RESET}")
                else:
                    bar = render_progress_bar(100, width=18)
                    buf.append(f"   5-Hour Quota  {bar}  {GREEN}Ready (100% available){RESET}")

                tok_info = get_token_reset_info(highlighted_acc.get("token_data", ""))
                if tok_info:
                    rem_str = tok_info.get("remaining_str", "Unknown")
                    buf.append(f"   Token Expiry  {CYAN}{rem_str}{RESET}")

            buf.append("")
            buf.append(f" {BOLD}ACTIONS{RESET}")

            action_items = items[len(acc_list):]
            for act_idx, (itype, label, val) in enumerate(action_items, len(acc_list)):
                is_selected = (act_idx == selected_idx)
                cursor = f"{ORANGE}❯{RESET}" if is_selected else " "
                if is_selected:
                    buf.append(f" {cursor} {BOLD}{BRIGHT_WHITE}{label}{RESET}")
                else:
                    buf.append(f" {cursor} {GRAY}{label}{RESET}")

            buf.append("")
            buf.append(sep_line)
            if message:
                if message_type == "success":
                    buf.append(f" {GREEN}✓ {message}{RESET}")
                elif message_type == "error":
                    buf.append(f" {RED}✕ {message}{RESET}")
                else:
                    buf.append(f" {CYAN}› {message}{RESET}")
            else:
                buf.append(f" {GRAY}Navigate: [↑/↓] │ Select: [Enter] │ Shortcuts: [a, d, i, q]{RESET}")

            sys.stdout.write("\033[H")
            for line in buf:
                sys.stdout.write(line + "\033[K\n")
            sys.stdout.write("\033[J")
            sys.stdout.flush()

            key = get_key()
            message = ""

            if key == "up":
                selected_idx -= 1
                if selected_idx < 0:
                    selected_idx = len(items) - 1
            elif key == "down":
                selected_idx += 1
                if selected_idx >= len(items):
                    selected_idx = 0
            elif key.isdigit():
                num = int(key)
                if 1 <= num <= len(acc_list):
                    selected_idx = num - 1
            elif key == "a":
                selected_idx = len(acc_list)
            elif key == "d":
                if selected_idx < len(acc_list):
                    pass
                else:
                    selected_idx = len(acc_list) + 1
            elif key == "i":
                selected_idx = len(acc_list) + 2
            elif key in ("q", "esc", "\x03", "\x04"):
                break
            elif key in ("backspace", "delete") and selected_idx < len(acc_list):
                acc_to_del = items[selected_idx][2]
                email_del = acc_to_del["email"]
                buf[-1] = f" {RED}Confirm delete {email_del}? Press [y] to confirm, any key to cancel.{RESET}"
                sys.stdout.write("\033[H")
                for line in buf:
                    sys.stdout.write(line + "\033[K\n")
                sys.stdout.write("\033[J")
                sys.stdout.flush()
                if get_key().lower() == "y":
                    accs = load_accounts()
                    if email_del in accs:
                        del accs[email_del]
                        save_accounts(accs)
                        message = f"Removed account {email_del}"
                        message_type = "success"
                else:
                    message = "Canceled"
                    message_type = "info"
                continue
            elif key in ("\r", "\n"):
                itype, label, val = items[selected_idx]

                if itype == "account":
                    sys.stdout.write("\033[?1049l\033[?25h")
                    sys.stdout.flush()
                    acc = val
                    print(f"Switching account to {BOLD}{acc['name']}{RESET} {GRAY}<{acc['email']}>{RESET}...")
                    with Spinner("Updating Keychain token..."):
                        success = set_keychain_token(acc["token_data"])
                        time.sleep(0.4)
                    if success:
                        message = f"Switched to {acc['email']}"
                        message_type = "success"
                    else:
                        message = f"Failed to switch to {acc['email']}"
                        message_type = "error"
                elif itype == "action":
                    sys.stdout.write("\033[?1049l\033[?25h")
                    sys.stdout.flush()

                    if val == "add":
                        success, msg = cmd_add_flow()
                        input("\nPress Enter to return...")
                        message = msg
                        message_type = "success" if success else "error"
                    elif val == "remove":
                        if selected_idx < len(acc_list):
                            acc_to_del = items[selected_idx][2]
                            email_del = acc_to_del["email"]
                            accs = load_accounts()
                            if email_del in accs:
                                del accs[email_del]
                                save_accounts(accs)
                                message = f"Removed {email_del}"
                                message_type = "success"
                        else:
                            message = "Highlight an account to remove"
                            message_type = "info"
                    elif val == "status":
                        cmd_status(None)
                        input("\nPress Enter to return...")
                    elif val == "quit":
                        break

                sys.stdout.write("\033[?1049h\033[?25l\033[H")
                sys.stdout.flush()
                continue
    finally:
        sys.stdout.write("\033[?1049l\033[?25h")
        sys.stdout.flush()

def main():
    enable_windows_ansi()
    parser = argparse.ArgumentParser(description="Minimal Multi-Account Switcher for Google Antigravity CLI (agy)")
    parser.add_argument("--add", action="store_true", help="Log in & add a Google account to managed accounts")
    parser.add_argument("--token", metavar="BLOB|-", help="Import a go-keyring token blob instead of reading active session ('-' = stdin). Use with --add.")
    parser.add_argument("--list", action="store_true", help="List all saved accounts")
    parser.add_argument("--switch-to", dest="switch_to", metavar="ACCOUNT", help="Switch to specific account (email or number)")
    parser.add_argument("--switch", action="store_true", help="Rotate/interactive switch")
    parser.add_argument("--remove", dest="remove_account", metavar="ACCOUNT", help="Remove a saved account")
    parser.add_argument("--status", action="store_true", help="Show active account details")
    parser.add_argument("--logout", action="store_true", help="Logout of active session")

    subparsers = parser.add_subparsers(dest="command", help="Subcommand to run")
    subparsers.add_parser("add", help="Log in & add a Google account")
    subparsers.add_parser("list", help="List all saved accounts")
    subparsers.add_parser("logout", help="Logout of active session")
    
    switch_parser = subparsers.add_parser("switch", help="Switch to an account")
    switch_parser.add_argument("account", nargs="?", help="Account email or index")

    remove_parser = subparsers.add_parser("remove", help="Remove a saved account")
    remove_parser.add_argument("account", nargs="?", help="Account email or index")

    subparsers.add_parser("status", help="Show active account details")

    args = parser.parse_args()

    if args.add or args.command == "add" or args.token is not None:
        cmd_add(args)
    elif args.list or args.command == "list":
        cmd_list(args)
    elif args.logout or args.command == "logout":
        cmd_logout(args)
    elif args.switch_to:
        args.account = args.switch_to
        cmd_switch(args)
    elif args.switch:
        args.account = None
        cmd_switch(args)
    elif args.remove_account:
        args.account = args.remove_account
        cmd_remove(args)
    elif args.command == "switch":
        cmd_switch(args)
    elif args.command == "remove":
        cmd_remove(args)
    elif args.command == "status" or args.status:
        cmd_status(args)
    else:
        cmd_interactive(args)

if __name__ == "__main__":
    main()
