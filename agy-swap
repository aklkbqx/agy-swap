def cmd_add_flow():
    current_token = get_current_keychain_token()
    accounts = load_accounts()
    
    active_email = None
    userinfo = None
    if current_token:
        token_json = decode_token(current_token)
        if token_json and "token" in token_json and "access_token" in token_json["token"]:
            with Spinner("Checking active Keychain session..."):
                userinfo = get_google_userinfo(token_json["token"]["access_token"])
            if userinfo and userinfo.get("email"):
                active_email = userinfo.get("email")

    if active_email and active_email not in accounts:
        name = userinfo.get("name", "Google User")
        accounts[active_email] = {
            "email": active_email,
            "name": name,
            "token_data": current_token
        }
        save_accounts(accounts)
        print(f"\n{GREEN}✔ Saved active session: {name} <{active_email}>{RESET}")
        return True, f"Saved session {active_email}"

    print(f"\n{BOLD}{ORANGE}=== Add New Antigravity Account ==={RESET}")
    print(f"{GRAY}Launching 'agy' to initiate Google OAuth browser login...{RESET}")
    print(f"{YELLOW}Please complete login in the opened browser window.{RESET}\n")
    
    backup_token = current_token
    try:
        delete_keychain_token()
        subprocess.run(["agy", "--print", "Hello"], check=False)
        
        new_token = get_current_keychain_token()
        if not new_token:
            print(f"\n{RED}Login was canceled or failed.{RESET}")
            if backup_token:
                set_keychain_token(backup_token)
            return False, "Login canceled"
            
        token_json = decode_token(new_token)
        if not token_json or "token" not in token_json or "access_token" not in token_json["token"]:
            print(f"\n{RED}Could not parse new login token.{RESET}")
            if backup_token:
                set_keychain_token(backup_token)
            return False, "Failed to parse token"
            
        access_token = token_json["token"]["access_token"]
        new_userinfo = None
        with Spinner("Fetching new profile details from Google..."):
            new_userinfo = get_google_userinfo(access_token)
            
        if new_userinfo and new_userinfo.get("email"):
            email = new_userinfo.get("email")
            name = new_userinfo.get("name", "Google User")
            accounts[email] = {
                "email": email,
                "name": name,
                "token_data": new_token
            }
            save_accounts(accounts)
            print(f"\n{GREEN}✔ Successfully logged in & saved account: {name} <{email}>{RESET}")
            return True, f"Logged in & added {email}"
        else:
            print(f"\n{YELLOW}Logged in, but could not fetch Google profile info.{RESET}")
            email = input("Enter account email manually: ").strip()
            if email:
                accounts[email] = {
                    "email": email,
                    "name": "Google User",
                    "token_data": new_token
                }
                save_accounts(accounts)
                print(f"\n{GREEN}✔ Added account: {email}{RESET}")
                return True, f"Added {email}"
            else:
                if backup_token:
                    set_keychain_token(backup_token)
                return False, "No email provided"
    except Exception as e:
        print(f"\n{RED}Error during login flow: {e}{RESET}")
        if backup_token:
            set_keychain_token(backup_token)
        return False, f"Login error: {e}"

def cmd_add(args):
    token_arg = getattr(args, "token", None)
    if token_arg is not None:
        token_str = sys.stdin.read().strip() if token_arg == "-" else token_arg.strip()
        if not token_str:
            print(f"{RED}Empty token provided.{RESET}")
            sys.exit(1)
        token_json = decode_token(token_str)
        if not token_json or "token" not in token_json or "access_token" not in token_json["token"]:
            print(f"{RED}Could not parse active token from Keychain.{RESET}")
            sys.exit(1)
            
        access_token = token_json["token"]["access_token"]
        userinfo = None
        with Spinner("Fetching user info from Google..."):
            userinfo = get_google_userinfo(access_token)
        
        if not userinfo:
            email = input("Enter email address manually: ").strip()
            name = "Unknown User"
        else:
            email = userinfo.get("email")
            name = userinfo.get("name", "Unknown User")

        if not email:
            print(f"{RED}Email address is required.{RESET}")
            sys.exit(1)

        accounts = load_accounts()
        accounts[email] = {
            "email": email,
            "name": name,
            "token_data": token_str
        }
        save_accounts(accounts)
        print(f"{GREEN}Account '{email}' successfully added to agy-swap.{RESET}")
    else:
        cmd_add_flow()


