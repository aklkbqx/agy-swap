def cmd_status(args):
    current_token = get_current_keychain_token()
    if not current_token:
        print("Status: Not logged in (No keychain token found)")
        return

    accounts = load_accounts()
    active_email = None
    for email, acc in accounts.items():
        if acc["token_data"] == current_token:
            active_email = email
            break

    if active_email:
        acc = accounts[active_email]
        print(f"Active Account: {GREEN}{acc['name']} <{acc['email']}>{RESET}")
    else:
        token_json = decode_token(current_token)
        email = "Unknown (unsaved)"
        if token_json and "token" in token_json and "access_token" in token_json["token"]:
            userinfo = get_google_userinfo(token_json["token"]["access_token"])
            if userinfo:
                email = userinfo.get("email", "Unknown")
        print(f"Active Account: {YELLOW}{email} (Not saved in agy-swap, run 'agy-swap add' to save it){RESET}")

def cmd_logout(args):
    current_token = get_current_keychain_token()
    if not current_token:
        print("You are already logged out.")
        return
    delete_keychain_token()
    print(f"{GREEN}Successfully logged out of active session.{RESET}")

def cmd_update(args):
    url = "https://raw.githubusercontent.com/aklkbqx/agy-swap/main/agy-swap"
    target = os.path.abspath(sys.argv[0])
    if not os.path.exists(target) or not os.access(target, os.W_OK):
        target = os.path.expanduser("~/.local/bin/agy-swap")
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=10) as response:
            content = response.read()
        if not content:
            print(f"{RED}Error: Empty update content received.{RESET}")
            return False
        temp_target = target + ".tmp"
        with open(temp_target, "wb") as f:
            f.write(content)
        os.chmod(temp_target, 0o755)
        os.replace(temp_target, target)
        print(f"{GREEN}✔ agy-swap updated successfully!{RESET}")
        return True
    except Exception as e:
        print(f"{RED}Failed to update: {e}{RESET}")
        return False

def cmd_interactive(args):
    if not sys.stdin.isatty():
        cmd_list(args)
        return

    sys.stdout.write("\033[?1049h\033[?25l\033[H")
    sys.stdout.flush()

    resolved_cache = {}

    def get_active_account_details(token_str, accounts):
        if not token_str:
            return None, None, False
        for email, acc in accounts.items():
            if acc["token_data"] == token_str:
                return email, acc["name"], True
        if token_str in resolved_cache:
            email, name = resolved_cache[token_str]
            return email, name, False
        return None, None, False

    try:
        selected_idx = 0
        message = ""
        message_type = "info"

        while True:
            accounts = load_accounts()
            current_token = get_current_keychain_token()
            
            if current_token and current_token not in resolved_cache:
                found_in_accounts = False
                for email, acc in accounts.items():
                    if acc["token_data"] == current_token:
                        found_in_accounts = True
                        break
                if not found_in_accounts:
                    sys.stdout.write("\033[H")
                    sys.stdout.flush()
                    with Spinner("Resolving active profile details..."):
                        token_json = decode_token(current_token)
                        if token_json and "token" in token_json and "access_token" in token_json["token"]:
                            userinfo = get_google_userinfo(token_json["token"]["access_token"])
                            if userinfo:
                                email = userinfo.get("email")
                                name = userinfo.get("name", "Unknown User")
                                resolved_cache[current_token] = (email, name)
            
            active_email, active_name, is_saved = get_active_account_details(current_token, accounts)
            acc_list = list(accounts.values())
            
            items = []
            for acc in acc_list:
                items.append(('account', f"{acc['name']} <{acc['email']}>", acc))
                
            items.append(('separator', f"{GRAY}────────────────────────────────────────────────────────{RESET}", None))
            items.append(('action', "[+] Add Current Session", 'add'))
            items.append(('action', "[-] Remove Account (Highlight + Delete)", 'remove'))
            items.append(('action', "[ℹ] Check Session Status", 'status'))
            items.append(('action', "[🔄] Update Switcher Script", 'update'))
            items.append(('action', "[🔓] Logout Active Session", 'logout'))
            items.append(('action', "[❌] Quit", 'quit'))

            if selected_idx >= len(items):
                selected_idx = len(items) - 1
            if selected_idx < 0:
                selected_idx = 0

            buf = []
            buf.extend(print_header())
            
            if active_email:
                if is_saved:
                    buf.append(f" {BOLD}Active Account:{RESET} {GREEN}● {active_name} <{active_email}>{RESET}")
                else:
                    buf.append(f" {BOLD}Active Account:{RESET} {YELLOW}● {active_email} (Not saved, press 'a' to save){RESET}")
            else:
                if current_token:
                    buf.append(f" {BOLD}Active Account:{RESET} {YELLOW}● Unknown Session (Not saved, press 'a' to save){RESET}")
                else:
                    buf.append(f" {BOLD}Active Account:{RESET} {RED}○ Not logged in{RESET}")
                
            buf.append("")
            buf.append(f" {GRAY}Arrows (↑/↓) to select. Enter to run. 'd' / Backspace to Delete:{RESET}")
            buf.append("")

            for idx, (itype, label, val) in enumerate(items):
                is_selected = (idx == selected_idx)
                prefix = f"{ORANGE}❯{RESET} " if is_selected else "  "
                
                if itype == 'separator':
                    buf.append(label)
                    continue
                    
                if itype == 'account':
                    is_active = (val["token_data"] == current_token)
                    marker = f"{GREEN}●{RESET} " if is_active else f"{GRAY}○{RESET} "
                    
                    if is_selected:
                        line = f"{prefix}{marker}{BOLD}{BRIGHT_WHITE}{label}{RESET} {GREEN}(active){RESET}" if is_active else f"{prefix}{marker}{BOLD}{BRIGHT_WHITE}{label}{RESET}"
                    else:
                        line = f"{prefix}{marker}{label} {GREEN}(active){RESET}" if is_active else f"{prefix}{marker}{GRAY}{label}{RESET}"
                else:
                    if is_selected:
                        line = f"{prefix}{BOLD}{ORANGE}{label}{RESET}"
                    else:
                        line = f"{prefix}{label}"
                buf.append(line)
                
            buf.append("")
            if message:
                if message_type == "success":
                    buf.append(f" {GREEN}✔ {message}{RESET}")
                elif message_type == "error":
                    buf.append(f" {RED}✘ {message}{RESET}")
                else:
                    buf.append(f" {BLUE}ℹ {message}{RESET}")
            else:
                buf.append("")

            sys.stdout.write("\033[H")
            for line in buf:
                sys.stdout.write(line + "\033[K\n")
            sys.stdout.write("\033[J")
            sys.stdout.flush()
            
            key = get_key()
            message = ""
            
            if key == 'up':
                selected_idx -= 1
                if selected_idx < 0:
                    selected_idx = len(items) - 1
                if items[selected_idx][0] == 'separator':
                    selected_idx -= 1
            elif key == 'down':
                selected_idx += 1
                if selected_idx >= len(items):
                    selected_idx = 0
                if items[selected_idx][0] == 'separator':
                    selected_idx += 1
            elif key.isdigit():
                num = int(key)
                if 1 <= num <= len(acc_list):
                    selected_idx = num - 1
            elif key == 'a':
                selected_idx = len(acc_list) + 1
            elif key == 'r':
                selected_idx = len(acc_list) + 2
            elif key == 's':
                selected_idx = len(acc_list) + 3
            elif key == 'u':
                selected_idx = len(acc_list) + 4
            elif key == 'l':
                selected_idx = len(acc_list) + 5
            elif key in ('q', 'esc', '\x03', '\x04'):
                break
            elif key in ('d', 'x', 'delete', 'backspace') and items[selected_idx][0] == 'account':
                acc_to_del = items[selected_idx][2]
                email_to_remove = acc_to_del["email"]
                
                message = f"Delete {email_to_remove}? Press 'y' to confirm, any other key to cancel"
                message_type = "info"
                
                buf[-2] = f" {BLUE}ℹ {message}{RESET}"
                sys.stdout.write("\033[H")
                for line in buf:
                    sys.stdout.write(line + "\033[K\n")
                sys.stdout.write("\033[J")
                sys.stdout.flush()
                
                conf_key = get_key()
                if conf_key.lower() == 'y':
                    accounts = load_accounts()
                    if email_to_remove in accounts:
                        del accounts[email_to_remove]
                        save_accounts(accounts)
                        message = f"Removed account {email_to_remove}"
                        message_type = "success"
                else:
                    message = "Deletion canceled"
                    message_type = "info"
                continue
            elif key in ('\r', '\n'):
                itype, label, val = items[selected_idx]
                sys.stdout.write("\033[?1049l\033[?25h")
                sys.stdout.flush()
                
                if itype == 'account':
                    acc = val
                    print(f"Switching account to {BLUE}{acc['name']} <{acc['email']}>{RESET}...")
                    with Spinner("Updating Keychain credentials..."):
                        success = set_keychain_token(acc["token_data"])
                        time.sleep(0.5)
                    if success:
                        message = f"Switched to {acc['email']}"
                        message_type = "success"
                    else:
                        message = f"Failed to switch to {acc['email']}"
                        message_type = "error"
                elif itype == 'action':
                    if val == 'add':
                        print(f"{BOLD}{ORANGE}--- Add Current Antigravity Session ---{RESET}")
                        token_str = get_current_keychain_token()
                        if not token_str:
                            print(f"{RED}No active Antigravity session found in Keychain. Please login first via 'agy'.{RESET}")
                            input("\nPress Enter to return...")
                        else:
                            token_json = decode_token(token_str)
                            if not token_json or "token" not in token_json or "access_token" not in token_json["token"]:
                                print(f"{RED}Could not parse active token.{RESET}")
                                input("\nPress Enter to return...")
                            else:
                                access_token = token_json["token"]["access_token"]
                                userinfo = None
                                with Spinner("Fetching Google user details..."):
                                    userinfo = get_google_userinfo(access_token)
                                    time.sleep(0.4)
                                
                                if not userinfo:
                                    print(f"{YELLOW}Could not fetch Google user info. Token might be expired.{RESET}")
                                    email = input("Enter email manually: ").strip()
                                    name = "Unknown User"
                                else:
                                    email = userinfo.get("email")
                                    name = userinfo.get("name", "Unknown User")
                                    print(f"Detected Session: {GREEN}{name} <{email}>{RESET}")
                                
                                if email:
                                    accounts = load_accounts()
                                    accounts[email] = {
                                        "email": email,
                                        "name": name,
                                        "token_data": token_str
                                    }
                                    save_accounts(accounts)
                                    print(f"\n{GREEN}✔ Account '{email}' added successfully.{RESET}")
                                    time.sleep(1.0)
                                    message = f"Account {email} added"
                                    message_type = "success"
                                else:
                                    print(f"{RED}Email is required.{RESET}")
                                    time.sleep(1.0)
                    elif val == 'remove':
                        message = "Highlight any account and press 'd', 'x' or Backspace to delete it."
                        message_type = "info"
                    elif val == 'status':
                        print(f"{BOLD}{BLUE}--- Session Status Details ---{RESET}")
                        cmd_status(None)
                        input("\nPress Enter to return...")
                    elif val == 'update':
                        print(f"{BOLD}{ORANGE}--- Update Switcher Script ---{RESET}")
                        with Spinner("Downloading latest version..."):
                            success = cmd_update(None)
                            time.sleep(0.5)
                        if success:
                            print(f"{GREEN}✔ Updated successfully! Please restart agy-swap.{RESET}")
                            time.sleep(1.5)
                            break
                        else:
                            input("\nPress Enter to return...")
                    elif val == 'logout':
                        print(f"{BOLD}{YELLOW}--- Logout Active Session ---{RESET}")
                        confirm = input("Confirm delete active password from Keychain? [y/N]: ").strip().lower()
                        if confirm == 'y':
                            with Spinner("Logging out..."):
                                delete_keychain_token()
                                time.sleep(0.5)
                            print(f"{GREEN}Logged out successfully.{RESET}")
                            time.sleep(1.0)
                            message = "Active session logged out"
                            message_type = "info"
                    elif val == 'quit':
                        break
                
                sys.stdout.write("\033[?1049h\033[?25l\033[H")
                sys.stdout.flush()
                continue
            
    finally:
        sys.stdout.write("\033[?1049l\033[?25h")
        sys.stdout.flush()

def main():
    enable_windows_ansi()
    parser = argparse.ArgumentParser(description="Multi-Account Switcher for Google Antigravity CLI (agy)")
    parser.add_argument("--add", action="store_true", help="Add current account to managed accounts")
    parser.add_argument("--token", metavar="BLOB|-", help="Import a go-keyring token blob instead of reading the active session ('-' = stdin). Use with --add.")
    parser.add_argument("--list", action="store_true", help="List all saved accounts")
    parser.add_argument("--switch-to", dest="switch_to", metavar="ACCOUNT", help="Switch to specific account (email or number)")
    parser.add_argument("--switch", action="store_true", help="Rotate/interactive switch")
    parser.add_argument("--remove", dest="remove_account", metavar="ACCOUNT", help="Remove a saved account")
    parser.add_argument("--status", action="store_true", help="Show active account details")
    parser.add_argument("--logout", action="store_true", help="Logout of the active session")
    parser.add_argument("--update", action="store_true", help="Update the switcher script to the latest version")

    subparsers = parser.add_subparsers(dest="command", help="Subcommand to run")
    subparsers.add_parser("add", help="Add current account")
    subparsers.add_parser("list", help="List all saved accounts")
    subparsers.add_parser("logout", help="Logout of active session")
    subparsers.add_parser("update", help="Update the switcher script")
    
    switch_parser = subparsers.add_parser("switch", help="Switch to an account")
    switch_parser.add_argument("account", nargs="?", help="Account email or index")

    remove_parser = subparsers.add_parser("remove", help="Remove a saved account")
    remove_parser.add_argument("account", nargs="?", help="Account email or index")

    subparsers.add_parser("status", help="Show active account details")

    args = parser.parse_args()

    if args.add or args.command == "add" or args.token is not None:
        cmd_add(args)
    elif args.list or args.command == "list":
        cmd_list(args)
    elif args.logout or args.command == "logout":
        cmd_logout(args)
    elif args.update or args.command == "update":
        cmd_update(args)
    elif args.switch_to:
        args.account = args.switch_to
        cmd_switch(args)
    elif args.switch:
        args.account = None
        cmd_switch(args)
    elif args.remove_account:
        args.account = args.remove_account
        cmd_remove(args)
    elif args.command == "switch":
        cmd_switch(args)
    elif args.command == "remove":
        cmd_remove(args)
    elif args.command == "status" or args.status:
        cmd_status(args)
    else:
        cmd_interactive(args)

if __name__ == "__main__":
    main()
