def get_google_userinfo(access_token):
    try:
        req = urllib.request.Request(
            "https://www.googleapis.com/oauth2/v3/userinfo",
            headers={"Authorization": f"Bearer {access_token}"}
        )
        with urllib.request.urlopen(req, timeout=5) as response:
            return json.loads(response.read().decode("utf-8"))
    except Exception:
        return None

def auto_scan_logs_for_limits():
    log_dir = os.path.expanduser("~/.gemini/antigravity-cli/log")
    if not os.path.exists(log_dir):
        return {}
    log_files = sorted(glob.glob(os.path.join(log_dir, "cli-*.log")), key=os.path.getmtime, reverse=True)
    if not log_files:
        return {}
        
    email_regex = re.compile(r"applyAuthResult:\s*email=([^\s,]+)")
    error_regex = re.compile(r"RESOURCE_EXHAUSTED.*?Resets\s+in\s+((?:\d+h)?(?:\d+m)?(?:\d+s)?)")
    ts_regex = re.compile(r"^[IWEF](\d{2})(\d{2})\s+(\d{2}):(\d{2}):(\d{2})")
    
    detected_limits = {}
    now = datetime.now(timezone.utc)
    current_year = now.year

    for log_file in log_files[:15]:
        current_email = None
        try:
            with open(log_file, "r", errors="ignore") as f:
                for line in f:
                    em_match = email_regex.search(line)
                    if em_match:
                        current_email = em_match.group(1).lower()
                    
                    err_match = error_regex.search(line)
                    if err_match and current_email:
                        dur_str = err_match.group(1).strip()
                        h_m = re.search(r"(\d+)h", dur_str)
                        m_m = re.search(r"(\d+)m", dur_str)
                        s_m = re.search(r"(\d+)s", dur_str)
                        h = int(h_m.group(1)) if h_m else 0
                        m = int(m_m.group(1)) if m_m else 0
                        s = int(s_m.group(1)) if s_m else 0
                        total_secs = h*3600 + m*60 + s
                        
                        ts_match = ts_regex.match(line)
                        if ts_match:
                            mon = int(ts_match.group(1))
                            day = int(ts_match.group(2))
                            hr = int(ts_match.group(3))
                            mi = int(ts_match.group(4))
                            se = int(ts_match.group(5))
                            log_dt = datetime(current_year, mon, day, hr, mi, se, tzinfo=timezone.utc)
                        else:
                            file_mtime = os.path.getmtime(log_file)
                            log_dt = datetime.fromtimestamp(file_mtime, tz=timezone.utc)
                            
                        reset_dt = log_dt + timedelta(seconds=total_secs)
                        
                        if reset_dt > now:
                            if current_email not in detected_limits or reset_dt > detected_limits[current_email]:
                                detected_limits[current_email] = reset_dt
        except Exception:
            pass
            
    return detected_limits

def load_accounts(sync_logs=True):
    if not os.path.exists(ACCOUNTS_FILE):
        accounts = {}
    else:
        try:
            with open(ACCOUNTS_FILE, "r") as f:
                accounts = json.load(f)
        except Exception:
            accounts = {}

    if sync_logs and accounts:
        changed = False
        now = datetime.now(timezone.utc)
        
        for email, acc in list(accounts.items()):
            limit_reset = acc.get("limit_reset")
            if limit_reset:
                try:
                    dt = datetime.fromisoformat(limit_reset)
                    if dt <= now:
                        acc.pop("limit_reset", None)
                        changed = True
                except Exception:
                    pass
                    
        detected_limits = auto_scan_logs_for_limits()
        for email, reset_dt in detected_limits.items():
            for acc_email, acc in accounts.items():
                if acc_email.lower() == email:
                    existing = acc.get("limit_reset")
                    new_iso = reset_dt.isoformat()
                    if existing != new_iso:
                        acc["limit_reset"] = new_iso
                        changed = True

        if changed:
            save_accounts(accounts)

    return accounts

def save_accounts(accounts):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(ACCOUNTS_FILE, "w") as f:
        json.dump(accounts, f, indent=2)

def decode_token(keychain_val):
    if not keychain_val or not keychain_val.startswith("go-keyring-base64:"):
        return None
    try:
        encoded = keychain_val.split(":", 1)[1]
        return json.loads(base64.b64decode(encoded).decode("utf-8"))
    except Exception:
        return None

def get_token_reset_info(token_data_str):
    token_json = decode_token(token_data_str)
    if not token_json or "token" not in token_json:
        return None
    token_obj = token_json["token"]
    expiry_str = token_obj.get("expiry")
    has_refresh = bool(token_obj.get("refresh_token"))
    
    if not expiry_str:
        return None
    try:
        dt = datetime.fromisoformat(expiry_str)
        now = datetime.now(timezone.utc)
        diff = (dt - now).total_seconds()
        if diff > 0:
            mins = int(diff // 60)
            secs = int(diff % 60)
            if mins >= 60:
                hours = mins // 60
                rem_mins = mins % 60
                return {"status": "active", "remaining_str": f"{hours}h {rem_mins}m", "seconds": diff, "expiry_dt": dt}
            return {"status": "active", "remaining_str": f"{mins}m {secs}s", "seconds": diff, "expiry_dt": dt}
        else:
            if has_refresh:
                return {"status": "ready", "remaining_str": "Token Ready (Auto-refreshes)", "seconds": diff, "expiry_dt": dt}
            else:
                abs_mins = int(abs(diff) // 60)
                return {"status": "expired", "remaining_str": f"Expired {abs_mins}m ago", "seconds": diff, "expiry_dt": dt}
    except Exception:
        return None

def get_account_limit_display(acc, is_active=False, current_token_str=None):
    token_str = current_token_str if (is_active and current_token_str) else acc.get("token_data", "")
    token_info = get_token_reset_info(token_str)
    limit_reset = acc.get("limit_reset")
    parts = []
    
    has_active_cooldown = False
    if limit_reset:
        try:
            dt = datetime.fromisoformat(limit_reset)
            now = datetime.now(timezone.utc)
            diff = (dt - now).total_seconds()
            if diff > 0:
                has_active_cooldown = True
                mins = int(diff // 60)
                secs = int(diff % 60)
                if mins >= 60:
                    h = mins // 60
                    m = mins % 60
                    parts.append(f"{RED}🔴 Quota Cooldown: Reset in {h}h {m}m{RESET}")
                else:
                    parts.append(f"{RED}🔴 Quota Cooldown: Reset in {mins}m {secs}s{RESET}")
            else:
                parts.append(f"{GREEN}🟢 Quota: Ready{RESET}")
        except Exception:
            pass

    if not has_active_cooldown and not limit_reset:
        parts.append(f"{GREEN}🟢 Quota: Ready{RESET}")

    return " │ ".join(parts) if parts else f"{GRAY}No status info{RESET}"



ANSI_ESCAPE = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])')

def visible_len(text):
    return len(ANSI_ESCAPE.sub('', text))

import shutil

def get_responsive_width():
    try:
        cols, _ = shutil.get_terminal_size((80, 24))
        return max(50, min(cols - 2, 110))
    except Exception:
        return 76

def tui_box_top(title="", width=76):

    if title:
        v_title_len = visible_len(title)
        pad = max(0, width - 5 - v_title_len)
        dashes = "─" * pad
        return f"{DARK_GRAY}╭─ {RESET}{BOLD}{BRIGHT_WHITE}{title}{RESET} {DARK_GRAY}{dashes}╮{RESET}"
    dashes = "─" * (width - 2)
    return f"{DARK_GRAY}╭{dashes}╮{RESET}"

def tui_box_mid(width=76):
    dashes = "─" * (width - 2)
    return f"{DARK_GRAY}├{dashes}┤{RESET}"

def tui_box_bot(width=76):
    dashes = "─" * (width - 2)
    return f"{DARK_GRAY}╰{dashes}╯{RESET}"

def tui_box_line(content_ansi, width=76):
    v_len = visible_len(content_ansi)
    if v_len > width - 4:
        raw_text = ANSI_ESCAPE.sub('', content_ansi)
        content_ansi = raw_text[:width - 7] + "..."
        v_len = visible_len(content_ansi)

    pad = max(0, width - 4 - v_len)
    spaces = " " * pad
    return f"{DARK_GRAY}│{RESET} {content_ansi}{spaces} {DARK_GRAY}│{RESET}"




def get_key():
    if platform.system() == "Windows":
        import msvcrt
        ch = msvcrt.getch()
        if ch in (b'\x00', b'\xe0'):
            ch2 = msvcrt.getch()
            if ch2 == b'H':
                return 'up'
            elif ch2 == b'P':
                return 'down'
            elif ch2 == b'M':
                return 'right'
            elif ch2 == b'K':
                return 'left'
        else:
            try:
                char = ch.decode('utf-8')
                if char in ('\r', '\n'):
                    return '\r'
                elif char in ('\x08', '\x7f'):
                    return 'backspace'
                elif char == '\x1b':
                    return 'esc'
                return char
            except Exception:
                return ''
    else:
        import tty
        import termios
        fd = sys.stdin.fileno()
        old_settings = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            ch = sys.stdin.read(1)
            if ch == '\x1b':
                ch2 = sys.stdin.read(1)
                if ch2 == '[':
                    ch3 = sys.stdin.read(1)
                    if ch3 == 'A':
                        return 'up'
                    elif ch3 == 'B':
                        return 'down'
                    elif ch3 == 'C':
                        return 'right'
                    elif ch3 == 'D':
                        return 'left'
                    elif ch3 == '3':
                        ch4 = sys.stdin.read(1)
                        if ch4 == '~':
                            return 'delete'
                return 'esc'
            elif ch in ('\x7f', '\x08'):
                return 'backspace'
            return ch
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

